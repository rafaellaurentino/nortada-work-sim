# Copie para .env e preencha. NUNCA suba o .env para o Git.

# Telegram (veja o README, passo 1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# IA gratuita (veja o README, passo 2)
# Opção A: Google AI Studio (Gemini)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Opção B: qualquer API compatível com OpenAI (ex.: Groq, OpenRouter). Exemplo:
# AI_PROVIDER=openai_compat
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=<nome do modelo gratuito atual do provedor>

TIMEZONE=America/Sao_Paulo
